# Server Configuration
PORT=3000
HOST=0.0.0.0

# Privy Configuration (for session signing)
PRIVY_USER_ID=your_privy_user_id_here
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# EVM Configuration (required)
# Private key of facilitator wallet used for fallback settlement
PRIVATE_KEY=your_evm_private_key_here
CLIENT_PRIVATE_KEY=your_client_private_key_here
FUNDING_PRIVATE_KEY=your_funding_private_key_here

# RPC endpoint for the target network (Base Sepolia)
RPC_URL=https://sepolia.base.org

# KRNL Configuration (enable atomic verify+settle)
KRNL_ENABLED=true
KRNL_NODE_URL=https://node.krnl.xyz

# Target contract and delegation configuration
TARGET_CONTRACT_ADDRESS=your_target_contract_address_here
RECIPIENT_ADDRESS=your_recipient_address_here
DELEGATED_ACCOUNT_ADDRESS=your_delegated_account_address_here

# EIP-4337 infrastructure (Base Sepolia)
BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=your_pimlico_api_key
PAYMASTER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=your_pimlico_api_key

# KRNL workflow configuration
ATTESTOR_IMAGE=image://docker.io/your_username/attestor-krnl-x402:latest
FACILITATOR_URL=https://your-facilitator-domain.com/x402

# Optional: Redis for distributed workflow tracking (production)
# REDIS_URL=redis://localhost:6379

# Optional: CDP SDK configuration
CDP_API_KEY_NAME=your_cdp_api_key_name_here
CDP_API_KEY_PRIVATE_KEY=your_cdp_api_key_private_key_here

# For USDC testing
USDC_CONTRACT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
